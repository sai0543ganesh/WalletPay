{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthenticateToRegistry",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublishWalletPayImagesOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/walletpay-api",
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/walletpay-web"
      ]
    }
  ]
}
