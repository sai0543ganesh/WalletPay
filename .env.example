# Backend production environment variables
# Use a JDBC URL, not a plain postgres:// URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/walletpay?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_JWT_EXPIRATION_MS=86400000
APP_BANK_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
APP_CORS_ALLOWED_ORIGINS=https://your-wallet-pay-frontend.onrender.com
JPA_DDL_AUTO=update
