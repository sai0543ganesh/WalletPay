# Non-secret Docker Compose settings. Run `node infra/scripts/setup-env.mjs`
# to create .env and random secrets under the ignored .secrets directory.
COMPOSE_PROJECT_NAME=walletpay
DATABASE_NAME=walletpay
DATABASE_USERNAME=walletpay
APP_PORT=8088
ALLOWED_ORIGINS=http://localhost:8088
COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=dev
SANDBOX_WEBHOOK_ENABLED=false
# Optional one-time simulated INR 100 credit, claimed manually once per account.
DEMO_FUNDING_ENABLED=false
JWT_TTL_MINUTES=15
# For the EC2 HTTPS override only:
DOMAIN=wallet.example.com
ACME_EMAIL=you@example.com
